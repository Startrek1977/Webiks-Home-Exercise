<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <RootNamespace>RoverRally.Core</RootNamespace>
    <AssemblyName>RoverRally.Core</AssemblyName>
    <ProjectGuid>{8F3A1C22-5B47-4E19-9D6A-11C4E7B0A331}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- Keyed on Configuration alone, not Platform: the SDK's implicit top
       import already defaults $(Platform) to AnyCPU before this file's own
       PropertyGroups run, so a Debug|x64 / Release|x64 condition silently
       fails to match whenever the project builds outside the .sln (which is
       what supplies Platform=x64) without also passing -p:Platform=x64 by
       hand. PlatformTarget above is unconditioned for the same reason. Same
       fix App and Tests already carry. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <!-- Binds appsettings.json's "Station" section into StationOptions
         (Configuration/StationOptions.cs). Pulls in Microsoft.Extensions.Configuration,
         .Abstractions and .FileExtensions transitively - RoverRally.App gets all of
         them for free via its ProjectReference to this project, needing no package
         reference of its own. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.1" />

    <!-- Rolling-file logging (#22). ILogger types appear in this project's own
         public signatures (TelemetryClient, CommandSender, BatteryGauge,
         SessionCacheFile, SessionCacheMigrator), so Logging.Abstractions is
         referenced directly rather than left to flow in transitively. Serilog
         itself is the composition-root implementation, wired up in
         Logging/Log.cs only - nothing else in Core references it. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
    <PackageReference Include="Serilog" Version="4.2.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

</Project>
