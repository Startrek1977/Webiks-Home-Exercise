<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>RoverRally.Core</RootNamespace>
    <AssemblyName>RoverRally.Core</AssemblyName>
    <ProjectGuid>{8F3A1C22-5B47-4E19-9D6A-11C4E7B0A331}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x86</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <!-- Keyed on Configuration alone, not Platform: the SDK's implicit top
       import already defaults $(Platform) to AnyCPU before this file's own
       PropertyGroups run, so a Debug|x86 / Release|x86 condition silently
       fails to match whenever the project builds outside the .sln (which is
       what supplies Platform=x86) without also passing -p:Platform=x86 by
       hand. PlatformTarget above is unconditioned for the same reason. Same
       fix App and Tests already carry. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="6.0.8" />
    <!-- NU1903: known high-severity CVE in 6.0.8; upgrade is deferred to #18, not this net8.0-windows retarget. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-5crp-9r3c-p9vr" />
    <!-- Not part of the net8.0 base class library; ConfigurationManager.AppSettings
         (StationSettings.cs) needs this package explicitly. System.Xml/System.Xml.Linq
         and Microsoft.Win32.Registry need no equivalent - they're implicit under
         net8.0-windows. -->
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
  </ItemGroup>

</Project>
