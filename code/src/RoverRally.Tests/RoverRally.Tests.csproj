<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <IsPackable>false</IsPackable>
    <!-- Needed as of #73: StationViewModelTests exercises members of App's
         StationViewModel (e.g. RoversView) that are typed with WPF types
         (ICollectionView, from PresentationFramework) rather than Core-only
         ones. The ProjectReference to RoverRally.App alone does not pull
         PresentationFramework in transitively - this project needs the same
         UseWPF opt-in App itself uses. -->
    <UseWPF>true</UseWPF>
    <RootNamespace>RoverRally.Tests</RootNamespace>
    <AssemblyName>RoverRally.Tests</AssemblyName>
    <ProjectGuid>{5C1B8E77-9F04-42A6-B3D1-8A2F6E44C019}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Keyed on Configuration alone, not Platform: the SDK's implicit top
         import already defaults $(Platform) to AnyCPU before this file's own
         PropertyGroups run, so a Debug|x64 / Release|x64 condition silently
         fails to match whenever the project builds outside the .sln (which is
         what supplies Platform=x64) without also passing -p:Platform=x64 by
         hand — including a plain `dotnet test`. PlatformTarget above is
         unconditioned for the same reason. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
    <!-- Referenced directly (#22) because TestSupport/CapturingLogger.cs
         implements ILogger itself, rather than relying on it flowing in
         transitively via the ProjectReference below. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoverRally.Core\RoverRally.Core.csproj" />
    <ProjectReference Include="..\RoverRally.App\RoverRally.App.csproj" />
  </ItemGroup>

</Project>
