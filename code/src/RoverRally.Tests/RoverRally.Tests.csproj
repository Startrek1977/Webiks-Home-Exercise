<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>RoverRally.Tests</RootNamespace>
    <AssemblyName>RoverRally.Tests</AssemblyName>
    <ProjectGuid>{5C1B8E77-9F04-42A6-B3D1-8A2F6E44C019}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x86</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Keyed on Configuration alone, not Platform: the SDK's implicit top
         import already defaults $(Platform) to AnyCPU before this file's own
         PropertyGroups run, so a Debug|x86 / Release|x86 condition silently
         fails to match whenever the project builds outside the .sln (which is
         what supplies Platform=x86) without also passing -p:Platform=x86 by
         hand — including a plain `dotnet test`. PlatformTarget above is
         unconditioned for the same reason. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoverRally.Core\RoverRally.Core.csproj" />
  </ItemGroup>

</Project>
