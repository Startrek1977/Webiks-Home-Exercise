<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="StationName" value="Kadima Proving Ground" />
    <add key="TelemetryPort" value="14550" />
    <add key="CommandPort" value="14551" />
    <add key="CommandHost" value="127.0.0.1" />
    <add key="RosterPath" value="Data\rovers.json" />
    <add key="SessionCachePath" value="Data\session-cache.bin" />
    <add key="TrackNorth" value="32.2830" />
    <add key="TrackSouth" value="32.2770" />
    <add key="TrackWest" value="34.9160" />
    <add key="TrackEast" value="34.9250" />
    <add key="DriveCommandIntervalMs" value="200" />
    <!-- Overview client attaches here; port is fixed by the site firewall rules. -->
    <add key="StationMonitorEndpoint" value="RoverRallyStation.rem" />
    <add key="StationMonitorPort" value="9091" />
    <add key="LogLevel" value="Info" />
  </appSettings>
</configuration>
