<UserControl x:Class="RoverRally.App.Views.StationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="#FF151920" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="#FF8A93A3" FontSize="12"
                           Text="{Binding LinkState, StringFormat='Link: {0}'}" />
                <TextBlock Grid.Column="1" Foreground="#FF8A93A3" FontSize="12" Margin="20,0,0,0"
                           Text="{Binding FrameCounterDisplay}" />
                <TextBlock Grid.Column="2" Foreground="#FF8A93A3" FontSize="12"
                           Text="{Binding SettingsViewModel.StationDisplay}" />
            </Grid>
        </Border>

        <!--
            Each tab's content resolves purely by the bound child view
            model's type, via the DataTemplates in App.xaml (#88) - the same
            mechanism StationView itself is resolved by, one level up. No
            View here ever names another tab's View or view model directly.
        -->
        <TabControl Background="{StaticResource PanelBackground}" BorderThickness="0">
            <TabItem Header="Track">
                <ContentControl Content="{Binding TrackViewModel}" />
            </TabItem>

            <TabItem Header="Fleet">
                <ContentControl Content="{Binding FleetViewModel}" />
            </TabItem>

            <TabItem Header="Settings">
                <ContentControl Content="{Binding SettingsViewModel}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
