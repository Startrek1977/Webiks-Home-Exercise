<UserControl x:Class="RoverRally.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:RoverRally.App.Converters"
             Background="#FF1E2229">
    <UserControl.Resources>
        <converters:EnumToBooleanConverter x:Key="EnumToBooleanConverter" />
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="16" MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="Operator preferences" Foreground="#FFE6E9EF" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Saved per operator on this station." Foreground="#FF6E7787" FontSize="11" Margin="0,2,0,10" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Speed units" Foreground="#FF8A93A3" VerticalAlignment="Center" Width="150" />
                <RadioButton Content="km/h" GroupName="Units" Foreground="#FFE6E9EF" Margin="0,0,16,0"
                             IsChecked="{Binding SpeedUnit, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=KilometresPerHour}" />
                <RadioButton Content="mph" GroupName="Units" Foreground="#FFE6E9EF"
                             IsChecked="{Binding SpeedUnit, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=MilesPerHour}" />
            </StackPanel>

            <Separator Margin="0,18" Background="#FF3A414C" />

            <TextBlock Text="Site configuration" Foreground="#FFE6E9EF" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Read from the application configuration file. Ask the site lead before changing these."
                       Foreground="#FF6E7787" FontSize="11" Margin="0,2,0,10" TextWrapping="Wrap" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Telemetry port" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding TelemetryPortDisplay}" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Command port" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding CommandPortDisplay}" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Roster file" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding RosterPathDisplay}" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Session cache" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SessionCacheDisplay}" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Track extent" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TrackExtentDisplay}" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Log level" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LogLevelDisplay}" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Station" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding StationDisplay}" Foreground="#FFE6E9EF" Margin="0,4" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
