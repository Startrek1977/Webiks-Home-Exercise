<UserControl x:Class="RoverRally.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#FF1E2229">
    <ScrollViewer>
        <StackPanel Margin="16" MaxWidth="620" HorizontalAlignment="Left">

            <TextBlock Text="Operator preferences" Foreground="#FFE6E9EF" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Saved per operator on this station." Foreground="#FF6E7787" FontSize="11" Margin="0,2,0,10" />

            <StackPanel Orientation="Horizontal">
                <TextBlock Text="Speed units" Foreground="#FF8A93A3" VerticalAlignment="Center" Width="150" />
                <RadioButton x:Name="KmhOption" Content="km/h" GroupName="Units" Foreground="#FFE6E9EF"
                             Margin="0,0,16,0" Checked="SpeedUnit_Changed" />
                <RadioButton x:Name="MphOption" Content="mph" GroupName="Units" Foreground="#FFE6E9EF"
                             Checked="SpeedUnit_Changed" />
            </StackPanel>

            <Separator Margin="0,18" Background="#FF3A414C" />

            <TextBlock Text="Site configuration" Foreground="#FFE6E9EF" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Text="Read from the application configuration file. Ask the site lead before changing these."
                       Foreground="#FF6E7787" FontSize="11" Margin="0,2,0,10" TextWrapping="Wrap" />

            <Grid x:Name="ConfigGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Telemetry port" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TelemetryPortText" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Command port" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="CommandPortText" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Roster file" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="RosterPathText" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Session cache" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="SessionCacheText" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Track extent" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TrackExtentText" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Overview endpoint" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="5" Grid.Column="1" x:Name="MonitorEndpointText" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Log level" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="6" Grid.Column="1" x:Name="LogLevelText" Foreground="#FFE6E9EF" Margin="0,4" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="Station" Foreground="#FF8A93A3" Margin="0,4" />
                <TextBlock Grid.Row="7" Grid.Column="1" x:Name="StationText" Foreground="#FFE6E9EF" Margin="0,4" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
