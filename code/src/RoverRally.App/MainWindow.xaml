<Window x:Class="RoverRally.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        Title="RoverRally Station" Height="760" Width="1180"
        Background="{StaticResource PanelBackground}">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding LoadedCommand}" />
        </i:EventTrigger>
        <i:EventTrigger EventName="Closing">
            <i:InvokeCommandAction Command="{Binding ClosingCommand}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>

    <!--
        The shell never constructs or references StationViewModel (#73): its
        DataContext is assigned externally by the composition root (App),
        and this ContentControl resolves the matching View purely through
        the DataTemplate registered in App.xaml against the view model's
        type. View and ViewModel do not know about each other.
    -->
    <ContentControl Content="{Binding}" />
</Window>
