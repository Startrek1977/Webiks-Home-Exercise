<Application x:Class="RoverRally.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:RoverRally.App.ViewModels"
             xmlns:views="clr-namespace:RoverRally.App.Views">
    <Application.Resources>
        <!--
            Registers which View renders a StationViewModel instance. This is
            the sole place the View/ViewModel association exists (#73) -
            neither MainWindow nor StationView's code-behind ever names the
            other's type; a ContentControl bound to a view model resolves its
            View purely by matching this DataTemplate's DataType.
        -->
        <DataTemplate DataType="{x:Type vm:StationViewModel}">
            <views:StationView />
        </DataTemplate>

        <!--
            Same mechanism, one level down (#88): each tab's own view model
            resolves its own View purely by type, so a tab's XAML can only
            ever see its own view model's members - never another tab's.
        -->
        <DataTemplate DataType="{x:Type vm:TrackViewModel}">
            <views:TrackTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:FleetViewModel}">
            <views:FleetView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <SolidColorBrush x:Key="PanelBackground" Color="#FF1E2229" />
        <SolidColorBrush x:Key="PanelForeground" Color="#FFE6E9EF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3FA7D6" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FFE8B03A" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FFD65A4A" />
        <SolidColorBrush x:Key="TrackSurface" Color="#FF2B3038" />
        <SolidColorBrush x:Key="QuietStateBrush" Color="#FF6E7787" />

        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FF8A93A3" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>

        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource PanelForeground}" />
            <Setter Property="FontSize" Value="18" />
            <Setter Property="FontFamily" Value="Consolas" />
        </Style>

        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="MinWidth" Value="90" />
        </Style>
    </Application.Resources>
</Application>
