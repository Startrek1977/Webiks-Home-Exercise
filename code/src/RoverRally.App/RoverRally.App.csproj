<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <WarningsAsErrors>Nullable</WarningsAsErrors>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>RoverRally.App</RootNamespace>
    <AssemblyName>RoverRally.Station</AssemblyName>
    <ProjectGuid>{2D7E4B90-1A63-4C58-8F22-6E9D0C5A7B44}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Keyed on Configuration alone, not Platform: the SDK's implicit top
         import already defaults $(Platform) to AnyCPU before this file's own
         PropertyGroups run, so a Debug|x64 / Release|x64 condition silently
         fails to match whenever the project builds outside the .sln (which is
         what supplies Platform=x64) without also passing -p:Platform=x64 by
         hand. PlatformTarget above is unconditioned for the same reason. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>portable</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>portable</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <!--
    Extra-credit single-file publish (#31): "dotnet publish ... -r win-x64"
    so the station can be copied whole to a laptop with no .NET installed.
    Only activates when a RuntimeIdentifier is supplied on the command line,
    so plain dotnet build/dotnet test/msbuild RoverRally.sln are completely
    unaffected and the documented build output path
    (bin\Debug|Release\RoverRally.Station.exe) does not move.
    PublishTrimmed is deliberately not set: WPF does not reliably support
    trimming.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\rovers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\session-cache.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Xaml.Behaviors.Wpf" Version="1.1.122" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoverRally.Core\RoverRally.Core.csproj" />
  </ItemGroup>

</Project>
