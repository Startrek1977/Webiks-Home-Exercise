<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <OutputType>WinExe</OutputType>
    <RootNamespace>RoverRally.App</RootNamespace>
    <AssemblyName>RoverRally.Station</AssemblyName>
    <ProjectGuid>{2D7E4B90-1A63-4C58-8F22-6E9D0C5A7B44}</ProjectGuid>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Deterministic>true</Deterministic>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Keyed on Configuration alone, not Platform: the SDK's implicit top
         import already defaults $(Platform) to AnyCPU before this file's own
         PropertyGroups run, so a Debug|x64 / Release|x64 condition silently
         fails to match whenever the project builds outside the .sln (which is
         what supplies Platform=x64) without also passing -p:Platform=x64 by
         hand. PlatformTarget above is unconditioned for the same reason. -->
    <OutputPath>bin\$(Configuration)\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\rovers.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Data\session-cache.bin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoverRally.Core\RoverRally.Core.csproj" />
  </ItemGroup>

</Project>
